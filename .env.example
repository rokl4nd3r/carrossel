APP_NAME=Carrossel MVP
OUTPUT_DIR=output
PUBLIC_BASE_URL=

SD_BASE_URL=http://127.0.0.1:7860
SD_STEPS=24
SD_CFG_SCALE=7
SD_WIDTH=1080
SD_HEIGHT=1350
SD_SAMPLER=DPM++ 2M Karras
SD_NEGATIVE_PROMPT=low quality, blurry, deformed, bad anatomy, watermark, logo, text, letters, words, typography, jpeg artifacts, cropped, frame, border

LLM_PROVIDER=fallback

# Use ollama para Luna/local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# Use openai_compatible para OpenRouter, LM Studio, Fireworks, vLLM etc.
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_COMPATIBLE_API_KEY=change-me
OPENAI_COMPATIBLE_MODEL=qwen/qwen3.5-9b

# Visual padrao
DEFAULT_STYLE=editorial premium, realistic background, cinematic light, clean composition, high detail, social media campaign background, no text
DEFAULT_BRAND_NAME=Carrossel
